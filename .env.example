# Local development. Copy to .env.local and adjust.
# On Vercel these come from the Neon integration (DATABASE_URL, DATABASE_URL_UNPOOLED)
# and from the project settings (BETTER_AUTH_SECRET).

DATABASE_URL=postgresql://tev:tev@localhost:5432/tev
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: force the public URL instead of deriving it from the request host.
# BETTER_AUTH_URL=http://localhost:3000
